[importlinter]
root_packages =
    apps
    config
include_external_packages = True

[importlinter:contract:domain-independent-of-transport]
name = Domain and core apps must not depend on the realtime transport (ADR-05v2)
type = forbidden
source_modules =
    apps.core
    apps.accounts
    apps.audit
    apps.notifications
    apps.media
    apps.catalog
    apps.artists
    apps.artworks
    apps.listings
    apps.favorites
    apps.cart
    apps.orders
    apps.auctions
    apps.settlements
    apps.dashboard
    apps.cms
forbidden_modules =
    apps.realtime
    channels
    channels_redis

[importlinter:contract:realtime-is-a-leaf]
name = Only the ASGI entry point and settings may wire the realtime app
type = forbidden
source_modules =
    apps.core
    apps.accounts
forbidden_modules =
    config.asgi

[importlinter:contract:media-is-generic]
name = The media app knows nothing about the features that use it
type = forbidden
source_modules =
    apps.media
forbidden_modules =
    apps.catalog
    apps.artists
    apps.artworks

[importlinter:contract:catalog-below-commerce]
name = The catalogue knows nothing about offers or favourites (commerce builds on it)
type = forbidden
source_modules =
    apps.catalog
    apps.artists
    apps.artworks
forbidden_modules =
    apps.listings
    apps.favorites
    apps.cart
    apps.orders
    apps.auctions
    apps.cms

[importlinter:contract:offers-below-orders]
name = Offers know nothing about carts or orders (orders build on offers)
type = forbidden
source_modules =
    apps.listings
forbidden_modules =
    apps.cart
    apps.orders
    apps.auctions

[importlinter:contract:auctions-on-top]
name = Orders and carts know nothing about auctions (auctions react to order signals)
type = forbidden
source_modules =
    apps.orders
    apps.cart
    apps.favorites
forbidden_modules =
    apps.auctions
    apps.settlements

[importlinter:contract:dashboard-is-a-leaf]
name = Nothing depends on the dashboard (it only reads other apps)
type = forbidden
source_modules =
    apps.core
    apps.accounts
    apps.audit
    apps.catalog
    apps.artists
    apps.artworks
    apps.listings
    apps.cart
    apps.orders
    apps.auctions
    apps.settlements
    apps.notifications
forbidden_modules =
    apps.dashboard

[importlinter:contract:notifications-is-generic]
name = Notifications know nothing about the features that send them
type = forbidden
source_modules =
    apps.notifications
forbidden_modules =
    apps.catalog
    apps.artists
    apps.artworks
    apps.listings
    apps.favorites
    apps.cart
    apps.orders
    apps.auctions
    apps.settlements
    apps.cms
    apps.dashboard
