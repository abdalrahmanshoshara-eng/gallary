[importlinter]
root_packages =
    apps
    config
include_external_packages = True

[importlinter:contract:domain-independent-of-transport]
name = Domain and core apps must not depend on the realtime transport (ADR-05v2)
type = forbidden
source_modules =
    apps.core
    apps.accounts
    apps.audit
    apps.media
    apps.catalog
    apps.artists
    apps.artworks
    apps.listings
    apps.favorites
forbidden_modules =
    apps.realtime
    channels
    channels_redis

[importlinter:contract:realtime-is-a-leaf]
name = Only the ASGI entry point and settings may wire the realtime app
type = forbidden
source_modules =
    apps.core
    apps.accounts
forbidden_modules =
    config.asgi

[importlinter:contract:media-is-generic]
name = The media app knows nothing about the features that use it
type = forbidden
source_modules =
    apps.media
forbidden_modules =
    apps.catalog
    apps.artists
    apps.artworks

[importlinter:contract:catalog-below-commerce]
name = The catalogue knows nothing about offers or favourites (commerce builds on it)
type = forbidden
source_modules =
    apps.catalog
    apps.artists
    apps.artworks
forbidden_modules =
    apps.listings
    apps.favorites
