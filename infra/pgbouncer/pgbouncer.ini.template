[databases]
; Any database name is forwarded to the PostgreSQL server (needed by the test runner).
* = host=${DB_HOST} port=${DB_PORT}

[pgbouncer]
listen_addr = 0.0.0.0
listen_port = 6432
unix_socket_dir =
auth_type = scram-sha-256
auth_file = ${PGB_RUNTIME_DIR}/userlist.txt

; Transaction pooling: Django runs with CONN_MAX_AGE=0 and
; DISABLE_SERVER_SIDE_CURSORS=True. Row locks (SELECT ... FOR UPDATE) work because
; they live inside a transaction.
pool_mode = transaction
max_client_conn = ${PGB_MAX_CLIENT_CONN}
default_pool_size = ${PGB_DEFAULT_POOL_SIZE}
min_pool_size = 2
reserve_pool_size = 5
reserve_pool_timeout = 3
server_reset_query = DISCARD ALL
server_reset_query_always = 0
ignore_startup_parameters = extra_float_digits,options
max_prepared_statements = 0

server_lifetime = 3600
server_idle_timeout = 600
query_wait_timeout = 30

log_connections = 0
log_disconnections = 0
stats_period = 60
admin_users = ${DB_USER}
