# Copy to .env (never commit .env). Values below are for LOCAL DEVELOPMENT only.
# Production values are provided by the server environment — see README "Production".

# --- PostgreSQL ------------------------------------------------------------------------
POSTGRES_DB=damascene
POSTGRES_USER=damascene
POSTGRES_PASSWORD=change-me-local-only

# --- Django ----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-local-only-0123456789abcdefghijklmnopqrstuvwxyz-0123456789
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,realtime
CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_ADMIN_PATH=internal-admin/
LOG_LEVEL=INFO

# --- Login codes (OTP) ----------------------------------------------------------------
# console  = development only: the code is printed in the worker output
#            (docker compose logs worker). Production refuses this value.
# disabled = default in production until the WhatsApp service is subscribed (BR-901c).
OTP_SENDER=console

# --- Redis (one server locally; separate URLs so they can be split later) -------------
REDIS_CACHE_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CHANNEL_LAYER_URL=redis://redis:6379/2

# --- Object storage (S3-compatible) — used from Phase 3 ---------------------------------
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=damascene-public
S3_PRIVATE_BUCKET=damascene-private

# --- Ports exposed on your machine ------------------------------------------------------
HTTP_PORT=8080
