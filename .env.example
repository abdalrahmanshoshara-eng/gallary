# Copy to .env (never commit .env). Values below are for LOCAL DEVELOPMENT only.
# Production values are provided by the server environment — see README "Production".

# --- PostgreSQL ------------------------------------------------------------------------
POSTGRES_DB=damascene
POSTGRES_USER=damascene
POSTGRES_PASSWORD=change-me-local-only

# --- Django ----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-local-only-0123456789abcdefghijklmnopqrstuvwxyz-0123456789
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,realtime
CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_ADMIN_PATH=internal-admin/
LOG_LEVEL=INFO

# --- Default Super Admin (created on first start by `ensure_super_admin`) -----------------
# Development defaults. Sign in at /login with this phone and password, then change the
# password from "حسابي". Production refuses the development password: set a strong one.
DEFAULT_SUPER_ADMIN_PHONE=0943959774
DEFAULT_SUPER_ADMIN_PASSWORD=admin123456
DEFAULT_SUPER_ADMIN_NAME=المدير العام

# --- Phone verification codes (WhatsApp OTP; not used for login) ---------------------------
# console  = development only: the code is printed in the worker output
#            (docker compose logs worker). Production refuses this value.
# disabled = default in production until the WhatsApp service is subscribed (BR-901c).
OTP_SENDER=console

# --- Notifications by e-mail (§26) --------------------------------------------------------
# In-app notifications always work. E-mail copies go out over SMTP when enabled.
# Development prints them to the worker log (console backend) unless SMTP is set here.
# Production refuses console/locmem backends, an empty EMAIL_HOST, or a non-https SITE_URL.
# Check the settings with: python manage.py send_test_email you@example.com
NOTIFICATIONS_EMAIL_ENABLED=true
SITE_URL=http://localhost:8080
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=منصة الفن الدمشقية <no-reply@example.com>

# --- Redis (one server locally; separate URLs so they can be split later) -------------
REDIS_CACHE_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CHANNEL_LAYER_URL=redis://redis:6379/2

# --- Object storage (S3-compatible, ADR-17) --------------------------------------------
# Development uses the SeaweedFS container; keys match infra/seaweedfs/s3.dev.json.
S3_ENDPOINT_URL=http://storage:8333
S3_ACCESS_KEY_ID=dev-access-key
S3_SECRET_ACCESS_KEY=dev-secret-key-change-me
S3_PUBLIC_BUCKET=damascene-public
S3_PRIVATE_BUCKET=damascene-private
# Browser-facing URL of the public bucket (nginx proxies /media/ to it in development).
MEDIA_PUBLIC_BASE_URL=http://localhost:8080/media

# --- Ports exposed on your machine ------------------------------------------------------
HTTP_PORT=8080
